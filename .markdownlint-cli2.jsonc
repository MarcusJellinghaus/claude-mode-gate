{
  "config": {
    "MD013": false,
    // Rule prefixes such as `git commit ` need a meaningful trailing space inside the code span.
    "MD038": false,
    "MD033": false,
    "MD041": false,
  },
  "globs": ["**/*.md"],
  // Skip gitignored files, such as the .scratch/ drafts of LLM sessions.
  "gitignore": true,
  "ignores": [
    ".claude/skills/**",
    ".claude/agents/**",
    "node_modules/**",
    "coverage/**",
    ".stryker-tmp/**",
    "reports/**",
    // mcp-coder's LLM-written plan files and logs: rules such as MD024 and MD040, which Prettier does not fix, would turn them into check findings.
    "pr_info/**",
  ],
}
