{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "plugin/hooks/register.ts",
    "plugin/hooks/policy.ts",
    "scripts/*.mjs",
    "tests/**/*.test.ts",
    "plugin/tests/**/*.test.ts"
  ],
  "project": [
    "plugin/hooks/**/*.ts",
    "plugin/types/**/*.ts",
    "plugin/tests/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "ignoreDependencies": ["claude-code"],
  "ignoreUnresolved": ["claude-code", "claude-code-tools", "claude-code-mcp"]
}
