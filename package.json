{
  "name": "claude-mode-gate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A Claude Code mod with switchable permission profiles: a safe baseline and named profiles you switch on and off. Bash that no active rule allows asks. For other tools the mod adds only its own rules and guards; Claude Code's own verdict applies to the rest.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "types:lay": "node scripts/lay-types.mjs --force",
    "typecheck": "node scripts/lay-types.mjs && tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "arch": "depcruise hooks types tests --config .dependency-cruiser.cjs && node scripts/check-arch-modules.mjs",
    "deadcode": "knip",
    "docs:lint": "markdownlint-cli2",
    "check:manifests": "node scripts/check-manifests.mjs",
    "check:catch": "node scripts/check-gating-catch.mjs",
    "check:pins": "node scripts/check-action-pins.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "audit": "node scripts/audit-gate.mjs",
    "check": "run-s typecheck lint format:check arch deadcode docs:lint check:manifests check:catch check:pins check:docs test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "knip": "^6.44.0",
    "markdownlint-cli2": "^0.24.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.3"
  }
}
